    estado = CONFIRMADA
}

object "sala03 : Sala" as sala {
    nombre = "Consultorio 3"
    ubicacion = "Planta baja, ala norte"
    capacidad = 2
    equipamiento = "Camilla, dinamometro, espejo postural"
}

object "horarioMartes : HorarioDisponible" as horario {
    diaSemana = MARTES
    horaInicio = "09:00"
    horaFin = "14:00"
    vigenteDesde = "2026-01-01"
    vigenteHasta = "2026-12-31"
}

object "recPush : Recordatorio" as rec {
    canal = PUSH
    fechaEnvioProgramada = "2026-05-19 10:00"
    fechaEnvioReal = "2026-05-19 10:00"
    mensaje = "Recuerde su cita manana a las 10:00"
