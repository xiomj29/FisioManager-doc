}

object "ia22Abr : AnalisisIA" as ia {
    sentimientoDetectado = "Positivo"
    palabrasClave = ["comodo", "mejor", "semana pasada"]
    alertas = []
    confianza = 0.91
    fechaProcesamiento = "2026-04-22 19:01"
}

' ============================================================
' Enlaces (links de instancias)
' ============================================================

ana --> ter : atendida por
ana --> hc : posee
hc --> diag
hc --> nota1
diag --> ter
nota1 --> ter

ana --> plan : tiene
plan --> ter : elaborado por
plan --> fase : contiene
plan --> nota1 : documentado por
plan --> asig : prescribe

cita --> ana
cita --> ter
cita --> sala
cita --> rec
cita --> plan
ter --> horario
sala --> horario

ter --> rut : crea
rut *-- param
param --> ej

asig --> rut
asig --> ana
asig --> ter
asig --> ses
ses --> fb
fb --> ia

@enduml
