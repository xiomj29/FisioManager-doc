}

object "paramSentadilla : ParametrosEjercicio" as param {
    repeticiones = 12
    series = 3
    descansoSegundos = 45
    orden = 1
    notasTerapeuta = "Banda verde, mantener tronco erguido"
}

object "asigRut : AsignacionRutina" as asig {
    fechaAsignacion = "2026-04-15"
    fechaInicio = "2026-04-15"
    fechaFin = "2026-05-30"
