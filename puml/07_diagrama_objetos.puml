@startuml FisioManager_DiagramaObjetos

' FisioManager - Diagrama de Objetos
' Instantanea del sistema: instancias concretas de las clases conceptuales
' Escenario: paciente Ana en tratamiento de rodilla, con cita proxima,
' (recordatorio enviado por push, coherente con los canales del sistema)
' plan de tratamiento activo y una sesion con feedback ya analizado.

skinparam backgroundColor #FAFAFA
skinparam objectBackgroundColor #E8F4F8
skinparam objectBorderColor #2E75B6
skinparam objectArrowColor #2E75B6
skinparam objectFontName Arial
skinparam objectFontSize 11
skinparam objectAttributeFontSize 10

title <b>FisioManager - Diagrama de Objetos</b>\n<size:11>Instantanea: tratamiento de rodilla en curso (paciente Ana Lopez)</size>

' ============================================================
' Usuarios
' ============================================================

object "ana : Paciente" as ana {
    nombre = "Ana"
    apellidos = "Lopez Garcia"
    email = "ana.lopez@correo.com"
    telefono = "5512345678"
    fechaNacimiento = "1992-04-18"
    genero = FEMENINO
    peso = 62.5
    altura = 1.68
    activo = true
}

object "drMartinez : Terapeuta" as ter {
    nombre = "Carlos"
    apellidos = "Martinez Ruiz"
    email = "c.martinez@fisio.mx"
    cedulaProfesional = "9876543"
    especialidad = "Rehabilitacion ortopedica"
}

