@startuml FisioManager_Secuencia_GestionCitas

skinparam backgroundColor #FEFEFE
skinparam sequence {
  ArrowColor #2E75B6
  ActorBorderColor #1F4E79
  LifeLineBorderColor #2E75B6
  ParticipantBorderColor #2E75B6
  ParticipantBackgroundColor #D6EAF8
  ParticipantFontColor #1F4E79
  ActorBackgroundColor #AED6F1
}
skinparam defaultFontName Arial
skinparam shadowing false

title Diagrama de Secuencia - Flujo 3: Gestion de Citas (Admin)

actor "Administrador" as Admin #AED6F1
participant "UIAgenda" as UI #D6EAF8
participant "appointment.service" as Gestor #D6EAF8
participant "availability.service" as Validador #D6EAF8
participant "notification.service" as Notif #D6EAF8
participant "email.service" as Email #D6EAF8
database "PostgreSQL" as DB #E8DAEF

== Consulta de Agenda ==

Admin -> UI : Accede a la agenda del dia
activate UI
UI -> Gestor : getAll(fecha, terapeutaId?, estado?)
activate Gestor
Gestor -> DB : SELECT citas WHERE fecha\nAND filtros
activate DB
DB --> Gestor : citas (SCHEDULED/CONFIRMED/\nCOMPLETED/CANCELLED)
deactivate DB
Gestor --> UI : citasDelDia[]
deactivate Gestor
UI --> Admin : Muestra agenda con estados

== Creacion de Nueva Cita ==

Admin -> UI : "Nueva cita" (paciente,\nterapeuta, fechaHora, sala?,\nrecurrencia?)
UI -> Gestor : create(datos, actor=ADMIN)
activate Gestor

Gestor -> Validador : assertWithinAvailability(\nterapeutaId, fechaHora)
activate Validador
Validador -> DB : SELECT disponibilidad\ndel terapeuta
activate DB
DB --> Validador : franjas
deactivate DB
Validador --> Gestor : dentro de horario
deactivate Validador

Gestor -> DB : findConflict(terapeutaId,\nfechaHora)
activate DB
DB --> Gestor : sin colision
deactivate DB

alt Disponible y sin colisiones
    Gestor -> DB : INSERT Cita (estado='SCHEDULED',\ngrupoRecurrencia? para serie)
    activate DB
    DB --> Gestor : citaId
    deactivate DB
    Gestor -> Email : sendAppointmentReminder(...)
    Gestor --> UI : Cita creada
    deactivate Gestor
    UI --> Admin : "Cita agendada"
else Fuera de horario o colision
    Gestor --> UI : Error de disponibilidad
    deactivate Gestor
    UI --> Admin : "El horario no esta disponible"
end

== Recordatorio 24h (automatico) ==

note over Notif, DB
  Un planificador en notification.service
  se ejecuta cada hora: detecta las citas
  a ~24h con recordada_24h=false, crea la
  Notificacion in-app, envia el correo y
  marca recordada_24h=true.
end note

== Envio Manual de Recordatorio ==

Admin -> UI : "Recordatorio" en una cita
UI -> Gestor : sendReminder(citaId)
activate Gestor
Gestor -> DB : SELECT cita + paciente + terapeuta
activate DB
DB --> Gestor : datos de la cita
deactivate DB
Gestor -> Email : sendAppointmentReminder(\npaciente, terapeuta, fechaHora)
Email --> Gestor : messageId
Gestor --> UI : Recordatorio enviado
deactivate Gestor
UI --> Admin : "Recordatorio enviado al paciente"
deactivate UI

note over Validador
  Valida dos condiciones: que la fecha
  este dentro del horario del terapeuta
  y que no exista colision con otra cita.
end note

@enduml
