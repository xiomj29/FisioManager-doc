@startuml FisioManager_Secuencia_GestionCitas

skinparam backgroundColor #FEFEFE
skinparam sequence {
  ArrowColor #2E75B6
  ActorBorderColor #1F4E79
  LifeLineBorderColor #2E75B6
  ParticipantBorderColor #2E75B6
  ParticipantBackgroundColor #D6EAF8
  ParticipantFontColor #1F4E79
  ActorBackgroundColor #AED6F1
}
skinparam defaultFontName Arial
skinparam shadowing false

title Diagrama de Secuencia - Flujo 3: Gestion de Citas (Admin)

actor "Administrador" as Admin #AED6F1
participant "UIAgenda" as UI #D6EAF8
participant "GestorCitas" as Gestor #D6EAF8
participant "ValidadorDisponibilidad" as Validador #D6EAF8
participant "Cita" as Cita #E8DAEF
participant "Recordatorio" as Recordatorio #E8DAEF
database "Base de Datos" as DB #E8DAEF

== Consulta de Agenda ==

Admin -> UI : Accede a la agenda\ndel dia
activate UI

UI -> Gestor : listarCitas(fecha,\nterapeutaId?, estado?)
activate Gestor

Gestor -> DB : SELECT citas\nWHERE fecha = hoy\nAND filtros
activate DB
DB --> Gestor : Lista de citas\n(SCHEDULED, COMPLETED,\nCANCELLED)
deactivate DB

Gestor --> UI : citasDelDia[]
deactivate Gestor

UI --> Admin : Mostrar agenda con\ncitas, estados y\nestadisticas del dia

== Creacion de Nueva Cita ==

Admin -> UI : Click "Nueva Cita"\ny completar formulario\n(paciente, terapeuta,\nfechaHora, motivo)

UI -> Gestor : crearCita(pacienteId,\nterapeutaId, fechaHora,\nmotivo, modalidad)
activate Gestor

Gestor -> Gestor : Validar campos\nrequeridos y formatos

Gestor -> Validador : verificarDisponibilidad(\nterapeutaId, fechaHora)
activate Validador

Validador -> DB : SELECT HorarioDisponible\nWHERE terapeutaId\nAND diaSemana
activate DB
DB --> Validador : Horarios del terapeuta
deactivate DB

Validador -> Validador : Verificar que fechaHora\nesta dentro del horario\ndel terapeuta

Validador -> DB : SELECT citas\nWHERE terapeutaId\nAND fechaHora\nAND estado = 'SCHEDULED'
activate DB
DB --> Validador : Citas existentes\nen ese horario
deactivate DB

Validador -> Validador : Detectar colisiones\ncon citas existentes

alt Horario disponible y sin colisiones
    Validador --> Gestor : disponible = true
    deactivate Validador

    Gestor -> DB : INSERT Cita\n(pacienteId, terapeutaId,\nfechaHora, motivo,\nestado='SCHEDULED')
    activate DB
    DB --> Gestor : Cita creada (citaId)
    deactivate DB

    Gestor -> Cita : instanciar(citaId,\nfechaHora, estado)
    activate Cita
    Cita --> Gestor : Cita confirmada
    deactivate Cita

    ' --- Programacion de Recordatorio ---
    Gestor -> Recordatorio : programarRecordatorio(\ncitaId, pacienteId,\nfechaHora)
    activate Recordatorio

    Recordatorio -> Recordatorio : Calcular fecha de envio\n(24h antes de la cita)

    Recordatorio -> DB : INSERT Recordatorio\n(citaId, canal='EMAIL',\nfechaEnvioProgramada,\nestado='PENDIENTE')
    activate DB
    DB --> Recordatorio : Recordatorio creado
    deactivate DB

    Recordatorio --> Gestor : Recordatorio programado
    deactivate Recordatorio

    Gestor --> UI : Cita creada exitosamente\ncon recordatorio programado
    deactivate Gestor

    UI --> Admin : Confirmacion:\n"Cita agendada para\n[fecha] con recordatorio"

else Horario no disponible o colision detectada
    Validador --> Gestor : disponible = false,\nmotivo: "Colision con\ncita existente" o\n"Fuera de horario"
    deactivate Validador

    Gestor --> UI : Error de disponibilidad\n(motivo)
    deactivate Gestor

    UI --> Admin : Alerta: "El horario\nseleccionado no esta\ndisponible. Seleccione\notro horario."
end

== Envio Manual de Recordatorio ==

Admin -> UI : Click "Recordatorio"\nen cita SCHEDULED

UI -> Gestor : enviarRecordatorio(citaId)
activate Gestor

Gestor -> DB : SELECT Cita\nJOIN Paciente, Terapeuta\nWHERE id = citaId
activate DB
DB --> Gestor : Datos de la cita\n(paciente, terapeuta,\nfechaHora)
deactivate DB

Gestor -> Recordatorio : enviarAhora(citaId,\npacienteEmail,\nterapeutaNombre, fechaHora)
activate Recordatorio

Recordatorio -> Recordatorio : Generar contenido\ndel mensaje\n(HTML con datos de cita)

Recordatorio -> DB : UPDATE Recordatorio\nSET estado='ENVIADO',\nfechaEnvioReal=now()
activate DB
DB --> Recordatorio : OK
deactivate DB

Recordatorio --> Gestor : Recordatorio enviado\n(messageId)
deactivate Recordatorio

Gestor --> UI : Recordatorio enviado\nexitosamente
deactivate Gestor

UI --> Admin : Confirmacion:\n"Recordatorio enviado\nal paciente"
deactivate UI

note over Admin, UI
  El Administrador gestiona la agenda
  de toda la clinica: puede filtrar
  por terapeuta, fecha y estado
  de las citas (SCHEDULED, COMPLETED,
  CANCELLED)
end note

note over Validador
  Verifica dos condiciones:
  1. Que la fechaHora este dentro
     del horario del terapeuta
  2. Que no existan colisiones
     con citas ya agendadas
end note

note over Recordatorio
  El recordatorio se programa
  automaticamente al crear la cita
  (24h antes) y puede enviarse
  manualmente por el Admin
end note

@enduml
