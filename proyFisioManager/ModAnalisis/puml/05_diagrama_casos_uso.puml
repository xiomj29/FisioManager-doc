@startuml FisioManager_CasosDeUso


skinparam backgroundColor #FAFAFA
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam shadowing false
skinparam roundCorner 10

skinparam actor {
    BackgroundColor #08427B
    BorderColor #073B6F
}
skinparam ActorFontColor #08427B
skinparam ActorFontStyle bold

skinparam usecase {
    BackgroundColor #E8F4F8
    BorderColor #2E75B6
    FontColor black
}

title <b>FisioManager - Diagrama de Casos de Uso</b>

left to right direction

actor "Paciente" as paciente
actor "Fisioterapeuta" as terapeuta
actor "Administrador" as admin
actor "Servicio IA" as ia <<sistema>>

rectangle "FisioManager" {

    usecase "Iniciar sesion" as UC01
    usecase "Cerrar sesion" as UC02
    usecase "Recuperar contrasena" as UC03

    usecase "Visualizar rutina\nasignada" as UC10
    usecase "Ejecutar ejercicio" as UC11
    usecase "Registrar feedback\npor voz" as UC12
    usecase "Registrar nivel\nde dolor" as UC13
    usecase "Registrar estado\nemocional" as UC14
    usecase "Consultar progreso\npersonal" as UC15
    usecase "Acceder a modulo\nde bienestar" as UC16

    usecase "Gestionar paciente" as UC20
    usecase "Registrar diagnostico" as UC21
    usecase "Consultar historial\nclinico" as UC22
    usecase "Crear rutina\npersonalizada" as UC23
    usecase "Asignar rutina\na paciente" as UC24
    usecase "Analizar feedback\ndel paciente" as UC25
    usecase "Visualizar dashboard\nde pacientes" as UC26
    usecase "Generar reporte\nde progreso" as UC27
    usecase "Elaborar plan\nde tratamiento" as UC28
    usecase "Registrar nota\nclinica" as UC29

    usecase "Supervisar uso\ndel sistema" as UC30
    usecase "Evaluar desempeno\nde terapeutas" as UC31

    usecase "Gestionar usuarios" as UC40
    usecase "Auditar accesos" as UC41
    usecase "Monitorear sistema" as UC42

    usecase "Transcribir audio" as UC50
    usecase "Resumir feedback\nclinico (LLM)" as UC51

    usecase "Definir disponibilidad\ny salas" as UC60
    usecase "Agendar cita" as UC61
    usecase "Consultar agenda" as UC62

    usecase "Unirse a lista\nde espera" as UC64
    usecase "Enviar mensajes\nen tiempo real" as UC65
    usecase "Consultar centro\nde notificaciones" as UC66
    usecase "Gestionar documentos\nclinicos" as UC67
    usecase "Registrar escalas\nde resultado" as UC68
    usecase "Marcar mapa\ncorporal de dolor" as UC69
}

paciente --> UC01
paciente --> UC02
paciente --> UC03
paciente --> UC10
paciente --> UC11
paciente --> UC12
paciente --> UC13
paciente --> UC14
paciente --> UC15
paciente --> UC16
paciente --> UC61
paciente --> UC64
paciente --> UC65
paciente --> UC66
paciente --> UC69

terapeuta --> UC01
terapeuta --> UC02
terapeuta --> UC20
terapeuta --> UC21
terapeuta --> UC22
terapeuta --> UC23
terapeuta --> UC24
terapeuta --> UC25
terapeuta --> UC26
terapeuta --> UC27
terapeuta --> UC28
terapeuta --> UC29
terapeuta --> UC60
terapeuta --> UC61
terapeuta --> UC62
terapeuta --> UC65
terapeuta --> UC66
terapeuta --> UC67
terapeuta --> UC68

admin --> UC01
admin --> UC30
admin --> UC31
admin --> UC27
admin --> UC40
admin --> UC41
admin --> UC42
admin --> UC60
admin --> UC66

