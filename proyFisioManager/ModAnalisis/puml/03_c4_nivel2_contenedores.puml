@startuml FisioManager_C4_Contenedores


skinparam backgroundColor #FAFAFA
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam shadowing false
skinparam roundCorner 10
skinparam linetype ortho

skinparam actor {
    BackgroundColor #08427B
    BorderColor #073B6F
}
skinparam ActorFontColor #08427B
skinparam ActorFontStyle bold

skinparam rectangle {
    BackgroundColor<<container>> #438DD5
    BorderColor<<container>> #2E6295
    FontColor<<container>> white
    BackgroundColor<<infra>> #6FA8DC
    BorderColor<<infra>> #2E6295
    FontColor<<infra>> white
    BackgroundColor<<externo>> #999999
    BorderColor<<externo>> #6B6B6B
    FontColor<<externo>> white
    FontStyle bold
}

skinparam database {
    BackgroundColor #438DD5
    BorderColor #2E6295
    FontColor white
}

title <b>FisioManager - C4 Nivel 2: Contenedores</b>

actor "Paciente" as paciente
actor "Terapeuta" as terapeuta
actor "Admin" as admin

rectangle "**FisioManager**" as boundary {

    rectangle "Reverse-proxy / TLS\n<size:9>[Caddy / nginx]</size>\n<size:9>HTTPS, sirve la SPA y</size>\n<size:9>enruta /api y /socket.io</size>" as proxy <<infra>>

    rectangle "Aplicacion Web SPA\n<size:9>[React + TypeScript + Vite, PWA]</size>\n<size:9>Interfaz responsiva, i18n,</size>\n<size:9>modo claro/oscuro, offline</size>" as spa <<container>>

    rectangle "API REST + WebSocket\n<size:9>[Node.js + Express + Socket.IO]</size>\n<size:9>Rutas -> Controladores -> Servicios</size>\n<size:9>-> Repositorios. JWT, Zod, Prisma,</size>\n<size:9>rate-limit, auditoria</size>" as api <<container>>

    rectangle "Transcripcion de voz\n<size:9>[Python + Whisper, en proceso]</size>\n<size:9>Convierte audio a texto</size>" as whisper <<container>>

    database "Base de Datos\n<size:9>[PostgreSQL 16 + Prisma]</size>" as bd
    rectangle "Cache / PubSub\n<size:9>[Redis] (escalado)</size>\n<size:9>Adapter de Socket.IO</size>" as redis <<infra>>
    rectangle "Object Storage\n<size:9>[MinIO / S3]</size>\n<size:9>Avatares y documentos</size>" as minio <<infra>>
    rectangle "Respaldos BD\n<size:9>[pg_dump programado]</size>" as backup <<infra>>
}

rectangle "Ollama\n<size:9>[LLM local]</size>\n<size:9>Resumenes clinicos</size>" as ollama <<externo>>
rectangle "Proveedor SMTP\n<size:9>[Correo]</size>" as smtp <<externo>>

paciente --> proxy : Usa\n<size:9>[HTTPS]</size>
terapeuta --> proxy
admin --> proxy

proxy --> spa : Sirve estaticos
proxy --> api : /api, /uploads,\n/socket.io
spa --> api : <size:9>[HTTPS / JSON + WebSocket]</size>

api --> bd : <size:9>[Prisma]</size>
api --> redis : <size:9>Eventos en vivo (multi-instancia)</size>
api --> minio : <size:9>[S3 API] uploads</size>
api --> whisper : <size:9>Transcribe audio</size>
api --> ollama : <size:9>[HTTP] resumenes</size>
api --> smtp : <size:9>Correos/recordatorios</size>
backup --> bd : <size:9>pg_dump</size>

@enduml
