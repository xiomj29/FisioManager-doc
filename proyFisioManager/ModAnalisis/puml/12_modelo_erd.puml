@startuml FisioManager_ERD

skinparam backgroundColor #FEFEFE
skinparam linetype ortho
skinparam defaultFontName Arial
skinparam shadowing false

skinparam class {
  BackgroundColor #D6EAF8
  BorderColor #2E75B6
  HeaderBackgroundColor #2E75B6
  HeaderFontColor #FFFFFF
  FontColor #1F4E79
  AttributeFontColor #1F4E79
}

hide circle
hide methods

title Modelo de Base de Datos ERD - FisioManager

entity "usuarios" as usuarios {
  * **id** : INT <<PK, AUTO_INCREMENT>>
  --
  * nombre : VARCHAR(100) <<NOT NULL>>
  * email : VARCHAR(150) <<UNIQUE, NOT NULL>>
  * password_hash : VARCHAR(255) <<NOT NULL>>
  * rol : ENUM('PACIENTE','TERAPEUTA','ADMIN') <<NOT NULL>>
  avatar_url : VARCHAR(500)
  telefono : VARCHAR(20)
  * activo : BOOLEAN <<DEFAULT true>>
  * created_at : TIMESTAMP <<DEFAULT NOW()>>
  * updated_at : TIMESTAMP <<ON UPDATE>>
}

entity "pacientes" as pacientes {
  * **usuario_id** : INT <<PK, FK>>
  --
  * edad : INT <<NOT NULL>>
  condicion : VARCHAR(255)
  * terapeuta_id : INT <<FK -> usuarios.id>>
  fecha_nacimiento : DATE
  genero : ENUM('M','F','OTRO')
  direccion : VARCHAR(300)
  contacto_emergencia : VARCHAR(100)
}

entity "terapeutas" as terapeutas {
  * **usuario_id** : INT <<PK, FK>>
  --
  especialidad : VARCHAR(150)
  cedula_profesional : VARCHAR(50) <<UNIQUE>>
  anios_experiencia : INT
  horario_atencion : VARCHAR(100)
  max_pacientes : INT <<DEFAULT 20>>
}

entity "administradores" as administradores {
  * **usuario_id** : INT <<PK, FK>>
  --
  nivel_acceso : ENUM('TOTAL','PARCIAL') <<DEFAULT 'TOTAL'>>
  area_responsable : VARCHAR(100)
}

entity "historial_clinico" as historial {
  * **id** : INT <<PK, AUTO_INCREMENT>>
  --
  * paciente_id : INT <<FK -> pacientes.usuario_id>>
  * fecha_apertura : DATE <<NOT NULL>>
  antecedentes_personales : TEXT
  antecedentes_familiares : TEXT
  alergias : TEXT
  medicamentos_actuales : TEXT
  * estado : ENUM('ACTIVO','CERRADO') <<DEFAULT 'ACTIVO'>>
  * created_at : TIMESTAMP <<DEFAULT NOW()>>
  * updated_at : TIMESTAMP <<ON UPDATE>>
}

entity "diagnosticos" as diagnosticos {
  * **id** : INT <<PK, AUTO_INCREMENT>>
  --
  * historial_id : INT <<FK -> historial_clinico.id>>
  * terapeuta_id : INT <<FK -> terapeutas.usuario_id>>
  * codigo_cie10 : VARCHAR(10) <<NOT NULL>>
  * descripcion : TEXT <<NOT NULL>>
  * fecha_diagnostico : DATE <<NOT NULL>>
  severidad : ENUM('LEVE','MODERADO','SEVERO')
  * activo : BOOLEAN <<DEFAULT true>>
}

entity "notas_clinicas" as notas {
  * **id** : INT <<PK, AUTO_INCREMENT>>
  --
  * historial_id : INT <<FK -> historial_clinico.id>>
  * terapeuta_id : INT <<FK -> terapeutas.usuario_id>>
  * contenido : TEXT <<NOT NULL>>
  * tipo : ENUM('EVOLUCION','INTERCONSULTA','ALTA')
  * fecha : TIMESTAMP <<NOT NULL>>
  * created_at : TIMESTAMP <<DEFAULT NOW()>>
}

entity "planes_tratamiento" as planes {
  * **id** : INT <<PK, AUTO_INCREMENT>>
  --
  * paciente_id : INT <<FK -> pacientes.usuario_id>>
  * terapeuta_id : INT <<FK -> terapeutas.usuario_id>>
  * diagnostico_id : INT <<FK -> diagnosticos.id>>
  * titulo : VARCHAR(200) <<NOT NULL>>
  * objetivo : TEXT <<NOT NULL>>
  * fecha_inicio : DATE <<NOT NULL>>
  fecha_fin_estimada : DATE
  * estado : ENUM('ACTIVO','PAUSADO','COMPLETADO','CANCELADO')
  * created_at : TIMESTAMP <<DEFAULT NOW()>>
  * updated_at : TIMESTAMP <<ON UPDATE>>
}

entity "fases_tratamiento" as fases {
  * **id** : INT <<PK, AUTO_INCREMENT>>
  --
  * plan_id : INT <<FK -> planes_tratamiento.id>>
  * nombre : VARCHAR(150) <<NOT NULL>>
  * numero_fase : INT <<NOT NULL>>
  * objetivo_fase : TEXT <<NOT NULL>>
  duracion_semanas : INT
  * estado : ENUM('PENDIENTE','EN_CURSO','COMPLETADA')
}

entity "rutinas" as rutinas {
  * **id** : INT <<PK, AUTO_INCREMENT>>
  --
  paciente_id : INT <<FK -> pacientes.usuario_id>>
  * titulo : VARCHAR(200) <<NOT NULL>>
  * tipo : ENUM('TRATAMIENTO','RELAJACION') <<NOT NULL>>
  * completada : BOOLEAN <<DEFAULT false>>
  fecha_asignacion : DATE
  descripcion : TEXT
  * created_at : TIMESTAMP <<DEFAULT NOW()>>
  * updated_at : TIMESTAMP <<ON UPDATE>>
}

entity "ejercicios" as ejercicios {
  * **id** : INT <<PK, AUTO_INCREMENT>>
  --
  * titulo : VARCHAR(200) <<NOT NULL>>
  descripcion : TEXT
  * tipo : ENUM('FISICO','RESPIRACION') <<NOT NULL>>
  parte_cuerpo : ENUM('RODILLA','ESPALDA','HOMBRO',\n'CUELLO','BRAZO','CADERA','TOBILLO','OTRO')
  video_url : VARCHAR(500)
  imagen_url : VARCHAR(500)
  * created_at : TIMESTAMP <<DEFAULT NOW()>>
}

entity "parametros_ejercicio" as parametros {
  * **id** : INT <<PK, AUTO_INCREMENT>>
  --
  * rutina_id : INT <<FK -> rutinas.id>>
  * ejercicio_id : INT <<FK -> ejercicios.id>>
  * orden : INT <<NOT NULL>>
  * duracion_minutos : DECIMAL(5,2) <<NOT NULL>>
  * repeticiones : INT <<DEFAULT 1>>
  * descanso_segundos : INT <<DEFAULT 30>>
  instrucciones_extra : TEXT
}

entity "asignaciones_rutina" as asignaciones {
  * **id** : INT <<PK, AUTO_INCREMENT>>
  --
  * rutina_origen_id : INT <<FK -> rutinas.id>>
  * paciente_id : INT <<FK -> pacientes.usuario_id>>
  * terapeuta_id : INT <<FK -> terapeutas.usuario_id>>
  * fecha_asignacion : TIMESTAMP <<DEFAULT NOW()>>
  fecha_inicio : DATE
  fecha_fin : DATE
  * estado : ENUM('ACTIVA','PAUSADA','COMPLETADA','CANCELADA')
  notas_terapeuta : TEXT
}

entity "sesiones_ejecucion" as sesiones {
  * **id** : INT <<PK, AUTO_INCREMENT>>
  --
  * asignacion_id : INT <<FK -> asignaciones_rutina.id>>
  * paciente_id : INT <<FK -> pacientes.usuario_id>>
  * fecha_inicio : TIMESTAMP <<NOT NULL>>
  fecha_fin : TIMESTAMP
  * estado : ENUM('EN_CURSO','COMPLETADA','ABANDONADA')
  progreso_porcentaje : DECIMAL(5,2)
  ejercicios_completados : INT
  tiempo_total_minutos : DECIMAL(5,2)
}

entity "feedback" as feedback {
  * **id** : INT <<PK, AUTO_INCREMENT>>
  --
  * sesion_id : INT <<FK -> sesiones_ejecucion.id>>
  * paciente_id : INT <<FK -> pacientes.usuario_id>>
  * rutina_id : INT <<FK -> rutinas.id>>
  * nivel_dolor : INT <<CHECK (1-10)>>
  * estado_emocional : ENUM('EXCELENTE','BIEN',\n'REGULAR','MAL','TERRIBLE')
  audio_url : VARCHAR(500)
  comentario_texto : TEXT
  * fecha : TIMESTAMP <<DEFAULT NOW()>>
}

entity "analisis_ia" as analisis_ia {
  * **id** : INT <<PK, AUTO_INCREMENT>>
  --
  * feedback_id : INT <<FK -> feedback.id, UNIQUE>>
  transcripcion_audio : TEXT
  * resumen : TEXT <<NOT NULL>>
  sentimiento : ENUM('POSITIVO','NEUTRAL','NEGATIVO')
  alertas : TEXT
  recomendaciones : TEXT
  * confianza_score : DECIMAL(3,2) <<CHECK (0-1)>>
  * procesado_at : TIMESTAMP <<NOT NULL>>
  * modelo_version : VARCHAR(50)
}

entity "citas" as citas {
  * **id** : INT <<PK, AUTO_INCREMENT>>
  --
  * paciente_id : INT <<FK -> pacientes.usuario_id>>
  * terapeuta_id : INT <<FK -> terapeutas.usuario_id>>
  * fecha_hora : TIMESTAMP <<NOT NULL>>
  * estado : ENUM('PROGRAMADA','CANCELADA','COMPLETADA')
  * sala_id : INT <<FK -> salas.id>>
  notas : TEXT
  recordatorio_enviado : BOOLEAN <<DEFAULT false>>
  * created_at : TIMESTAMP <<DEFAULT NOW()>>
  * updated_at : TIMESTAMP <<ON UPDATE>>
}

entity "salas" as salas {
  * **id** : INT <<PK, AUTO_INCREMENT>>
  --
  * nombre : VARCHAR(100) <<NOT NULL>>
  * capacidad : INT <<DEFAULT 1>>
  equipamiento : TEXT
  * piso : INT
  * disponible : BOOLEAN <<DEFAULT true>>
}

entity "recordatorios" as recordatorios {
  * **id** : INT <<PK, AUTO_INCREMENT>>
  --
  * cita_id : INT <<FK -> citas.id>>
  * usuario_id : INT <<FK -> usuarios.id>>
  * tipo : ENUM('EMAIL','SMS','PUSH') <<NOT NULL>>
  * mensaje : TEXT <<NOT NULL>>
  * fecha_envio : TIMESTAMP <<NOT NULL>>
  * enviado : BOOLEAN <<DEFAULT false>>
  fecha_enviado_real : TIMESTAMP
  * intentos : INT <<DEFAULT 0>>
}

entity "modulos_bienestar" as bienestar {
  * **id** : INT <<PK, AUTO_INCREMENT>>
  --
  * paciente_id : INT <<FK -> pacientes.usuario_id>>
  * fecha : DATE <<NOT NULL>>
  horas_sueno : DECIMAL(3,1)
  nivel_estres : INT <<CHECK (1-10)>>
  nivel_energia : INT <<CHECK (1-10)>>
  hidratacion_litros : DECIMAL(3,1)
  notas : TEXT
  * created_at : TIMESTAMP <<DEFAULT NOW()>>
}

' ===== RELACIONES =====

usuarios ||--o| pacientes : "es un"
usuarios ||--o| terapeutas : "es un"
usuarios ||--o| administradores : "es un"

pacientes }|--|| terapeutas : "asignado a"

pacientes ||--|{ historial : "tiene"
historial ||--o{ diagnosticos : "contiene"
historial ||--o{ notas : "tiene"
terapeutas ||--o{ diagnosticos : "registra"
terapeutas ||--o{ notas : "escribe"

pacientes ||--o{ planes : "recibe"
terapeutas ||--o{ planes : "define"
diagnosticos ||--o{ planes : "origina"
planes ||--|{ fases : "compuesto por"

rutinas }o--o| pacientes : "asignada a"
ejercicios ||--o{ parametros : "configurado en"
rutinas ||--|{ parametros : "contiene"

terapeutas ||--o{ asignaciones : "asigna"
pacientes ||--o{ asignaciones : "recibe"
rutinas ||--o{ asignaciones : "origen"

asignaciones ||--o{ sesiones : "genera"
pacientes ||--o{ sesiones : "ejecuta"

sesiones ||--o| feedback : "produce"
pacientes ||--o{ feedback : "registra"
rutinas ||--o{ feedback : "evaluada en"

feedback ||--o| analisis_ia : "analizado por"

pacientes ||--o{ citas : "asiste a"
terapeutas ||--o{ citas : "atiende"
salas ||--o{ citas : "reservada para"

citas ||--o{ recordatorios : "genera"
usuarios ||--o{ recordatorios : "recibe"

pacientes ||--o{ bienestar : "registra"

@enduml
