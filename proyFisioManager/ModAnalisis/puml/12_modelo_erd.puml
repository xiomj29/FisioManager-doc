@startuml FisioManager_ERD

skinparam backgroundColor #FEFEFE
skinparam linetype ortho
skinparam defaultFontName Arial
skinparam shadowing false

skinparam class {
  BackgroundColor #D6EAF8
  BorderColor #2E75B6
  HeaderBackgroundColor #2E75B6
  HeaderFontColor #FFFFFF
  FontColor #1F4E79
  AttributeFontColor #1F4E79
}

hide circle
hide methods

title Modelo de Base de Datos ERD - FisioManager\n<size:11>PostgreSQL gestionado con Prisma ORM (claves primarias tipo cuid)</size>

entity "usuarios" as usuarios {
  * **id** : TEXT <<PK, cuid>>
  --
  * nombre : TEXT <<NOT NULL>>
  * email : TEXT <<UNIQUE, NOT NULL>>
  * password : TEXT <<NOT NULL>>
  * rol : TEXT <<PATIENT|THERAPIST|ADMIN>>
  * activo : BOOLEAN <<DEFAULT true>>
  * email_verificado : BOOLEAN <<DEFAULT true>>
  avatar_url : TEXT
  telefono : TEXT
  consentimiento_audio_at : TIMESTAMP
  * created_at : TIMESTAMP <<DEFAULT now()>>
  * updated_at : TIMESTAMP <<ON UPDATE>>
}

entity "perfiles_paciente" as pacientes {
  * **usuario_id** : TEXT <<PK, FK>>
  --
  * edad : INT <<NOT NULL>>
  * condicion : TEXT <<NOT NULL>>
  * terapeuta_id : TEXT <<FK -> usuarios.id>>
}

entity "perfiles_terapeuta" as terapeutas {
  * **usuario_id** : TEXT <<PK, FK>>
  --
  cedula : TEXT
  especialidad : TEXT
}

entity "disponibilidad_terapeuta" as disponibilidad {
  * **id** : TEXT <<PK, cuid>>
  --
  * terapeuta_id : TEXT <<FK -> usuarios.id>>
  * dia_semana : INT <<0=Dom..6=Sab>>
  * hora_inicio : TEXT <<HH:MM>>
  * hora_fin : TEXT <<HH:MM>>
  .. UNIQUE(terapeuta_id, dia_semana) ..
}

entity "historial_clinico" as historial {
  * **id** : TEXT <<PK, cuid>>
  --
  * paciente_id : TEXT <<UNIQUE, FK>>
  tipo_sangre : TEXT
  alergias : TEXT
  antecedentes : TEXT
  * created_at : TIMESTAMP <<DEFAULT now()>>
  * updated_at : TIMESTAMP <<ON UPDATE>>
}

entity "diagnosticos" as diagnosticos {
  * **id** : TEXT <<PK, cuid>>
  --
  * historial_id : TEXT <<FK>>
  * codigo_cie10 : TEXT <<NOT NULL>>
  * descripcion : TEXT <<NOT NULL>>
  * estado : TEXT <<ACTIVE|RESOLVED>>
  * created_at : TIMESTAMP <<DEFAULT now()>>
  * updated_at : TIMESTAMP <<ON UPDATE>>
}

entity "notas_clinicas" as notas {
  * **id** : TEXT <<PK, cuid>>
  --
  * historial_id : TEXT <<FK>>
  * autor_id : TEXT <<FK -> usuarios.id>>
  * contenido : TEXT <<NOT NULL>>
  * visible_paciente : BOOLEAN <<DEFAULT false>>
  * created_at : TIMESTAMP <<DEFAULT now()>>
}

entity "documentos_clinicos" as documentos {
  * **id** : TEXT <<PK, cuid>>
  --
  * paciente_id : TEXT <<FK>>
  * subido_por : TEXT <<FK -> usuarios.id>>
  * nombre_archivo : TEXT <<NOT NULL>>
  * url_archivo : TEXT <<NOT NULL>>
  * mime_type : TEXT <<NOT NULL>>
  * tamano_bytes : INT <<NOT NULL>>
  * categoria : TEXT <<XRAY|LAB|CONSENT|REPORT|OTHER>>
  * visible_paciente : BOOLEAN <<DEFAULT false>>
  * created_at : TIMESTAMP <<DEFAULT now()>>
}

entity "planes_tratamiento" as planes {
  * **id** : TEXT <<PK, cuid>>
  --
  * paciente_id : TEXT <<FK>>
  * terapeuta_id : TEXT <<FK>>
  * nombre : TEXT <<NOT NULL>>
  objetivo_clinico : TEXT
  * fecha_inicio : TIMESTAMP <<NOT NULL>>
  fecha_fin : TIMESTAMP
  * estado : TEXT <<ACTIVE|COMPLETED|SUSPENDED>>
  * created_at : TIMESTAMP <<DEFAULT now()>>
  * updated_at : TIMESTAMP <<ON UPDATE>>
}

entity "fases_tratamiento" as fases {
  * **id** : TEXT <<PK, cuid>>
  --
  * plan_id : TEXT <<FK>>
  * nombre : TEXT <<NOT NULL>>
  * orden : INT <<NOT NULL>>
  * duracion_semanas : INT <<NOT NULL>>
  objetivos : TEXT
  * created_at : TIMESTAMP <<DEFAULT now()>>
}

entity "plantillas_actividad" as plantillas {
  * **id** : TEXT <<PK, cuid>>
  --
  * titulo : TEXT <<NOT NULL>>
  * descripcion : TEXT <<NOT NULL>>
  * tipo : TEXT <<PHYSICAL|BREATHING>>
  parte_cuerpo : TEXT <<KNEE|BACK|...>>
  video_url : TEXT
  imagen_url : TEXT
  * created_at : TIMESTAMP <<DEFAULT now()>>
}

entity "rutinas" as rutinas {
  * **id** : TEXT <<PK, cuid>>
  --
  paciente_id : TEXT <<FK (null=plantilla)>>
  * titulo : TEXT <<NOT NULL>>
  * tipo : TEXT <<TREATMENT|RELAXATION>>
  * completada : BOOLEAN <<DEFAULT false>>
  fecha_asignacion : TIMESTAMP
  * created_at : TIMESTAMP <<DEFAULT now()>>
  * updated_at : TIMESTAMP <<ON UPDATE>>
}

entity "actividades" as actividades {
  * **id** : TEXT <<PK, cuid>>
  --
  * rutina_id : TEXT <<FK>>
  plantilla_id : TEXT
  * titulo : TEXT <<NOT NULL>>
  * descripcion : TEXT <<NOT NULL>>
  * duracion_minutos : INT <<NOT NULL>>
  descanso_segundos : INT
  * repeticiones : INT <<NOT NULL>>
  * tipo : TEXT <<PHYSICAL|BREATHING>>
  * orden : INT <<NOT NULL>>
}

entity "asignaciones_rutina" as asignaciones {
  * **id** : TEXT <<PK, cuid>>
  --
  * rutina_id : TEXT <<FK>>
  * paciente_id : TEXT <<FK>>
  * terapeuta_id : TEXT <<FK>>
  fase_id : TEXT <<FK -> fases.id>>
  * fecha_inicio : TIMESTAMP <<NOT NULL>>
  fecha_fin : TIMESTAMP
  * frecuencia : TEXT <<DAILY|EVERY_OTHER_DAY|WEEKLY>>
  * estado : TEXT <<ACTIVE|PAUSED|CANCELLED>>
  ultimo_recordatorio_at : TIMESTAMP
}

entity "sesiones" as sesiones {
  * **id** : TEXT <<PK, cuid>>
  --
  * rutina_id : TEXT <<FK>>
  * paciente_id : TEXT <<FK>>
  * estado : TEXT <<IN_PROGRESS|FINISHED>>
  tasa_cumplimiento : FLOAT
  * iniciada_at : TIMESTAMP <<DEFAULT now()>>
  finalizada_at : TIMESTAMP
}

entity "sesion_ejercicios" as sesionEj {
  * **id** : TEXT <<PK, cuid>>
  --
  * sesion_id : TEXT <<FK>>
  * actividad_id : TEXT
  * orden : INT
  * estado : TEXT <<COMPLETED|SKIPPED>>
  .. UNIQUE(sesion_id, actividad_id) ..
}

entity "feedback" as feedback {
  * **id** : TEXT <<PK, cuid>>
  --
  rutina_id : TEXT <<FK>>
  * paciente_id : TEXT <<FK>>
  * nivel_dolor : INT <<1-10>>
  * estado_emocional : TEXT <<GREAT|GOOD|OK|BAD|TERRIBLE>>
  audio_url : TEXT
  transcripcion : TEXT
  resumen_ia : TEXT
  * fecha : TIMESTAMP <<DEFAULT now()>>
}

entity "puntos_dolor" as puntosDolor {
  * **id** : TEXT <<PK, cuid>>
  --
  feedback_id : TEXT <<FK>>
  * paciente_id : TEXT
  * parte_cuerpo : TEXT <<KNEE|BACK|...>>
  lado : TEXT <<LEFT|RIGHT|CENTER>>
  * intensidad : INT <<1-10>>
  nota : TEXT
  * created_at : TIMESTAMP <<DEFAULT now()>>
}

entity "escalas_resultado" as escalas {
  * **id** : TEXT <<PK, cuid>>
  --
  * paciente_id : TEXT
  * terapeuta_id : TEXT
  * tipo : TEXT <<ROM|STRENGTH|FUNCTIONAL|VAS>>
  etiqueta : TEXT
  * valor : FLOAT <<NOT NULL>>
  unidad : TEXT
  * medido_at : TIMESTAMP <<DEFAULT now()>>
}

entity "citas" as citas {
  * **id** : TEXT <<PK, cuid>>
  --
  * paciente_id : TEXT <<FK>>
  * terapeuta_id : TEXT <<FK>>
  * fecha_hora : TIMESTAMP <<NOT NULL>>
  * estado : TEXT <<SCHEDULED|CONFIRMED|CANCELLED|COMPLETED>>
  sala_id : TEXT <<FK>>
  plan_tratamiento_id : TEXT <<FK>>
  notas : TEXT
  * recordada_24h : BOOLEAN <<DEFAULT false>>
  grupo_recurrencia_id : TEXT
  * created_at : TIMESTAMP <<DEFAULT now()>>
  * updated_at : TIMESTAMP <<ON UPDATE>>
}

entity "salas" as salas {
  * **id** : TEXT <<PK, cuid>>
  --
  * nombre : TEXT <<NOT NULL>>
  ubicacion : TEXT
  * capacidad : INT <<DEFAULT 1>>
  equipamiento : TEXT
  * created_at : TIMESTAMP <<DEFAULT now()>>
}

entity "lista_espera" as listaEspera {
  * **id** : TEXT <<PK, cuid>>
  --
  * paciente_id : TEXT
  * terapeuta_id : TEXT
  * desde : TIMESTAMP <<NOT NULL>>
  * hasta : TIMESTAMP <<NOT NULL>>
  * estado : TEXT <<WAITING|NOTIFIED|FULFILLED|CANCELLED>>
  * created_at : TIMESTAMP <<DEFAULT now()>>
}

entity "conversaciones" as conversaciones {
  * **id** : TEXT <<PK, cuid>>
  --
  * paciente_id : TEXT
  * terapeuta_id : TEXT
  * ultimo_mensaje_at : TIMESTAMP <<DEFAULT now()>>
  * created_at : TIMESTAMP <<DEFAULT now()>>
  .. UNIQUE(paciente_id, terapeuta_id) ..
}

entity "mensajes" as mensajes {
  * **id** : TEXT <<PK, cuid>>
  --
  * conversacion_id : TEXT <<FK>>
  * emisor_id : TEXT
  * contenido : TEXT <<NOT NULL>>
  leido_at : TIMESTAMP
  * created_at : TIMESTAMP <<DEFAULT now()>>
}

entity "notificaciones" as notificaciones {
  * **id** : TEXT <<PK, cuid>>
  --
  * usuario_id : TEXT <<FK>>
  * tipo : TEXT <<APPOINTMENT|ROUTINE|HIGH_PAIN|MESSAGE|SYSTEM>>
  * titulo : TEXT <<NOT NULL>>
  * cuerpo : TEXT <<NOT NULL>>
  link_url : TEXT
  * leida : BOOLEAN <<DEFAULT false>>
  * created_at : TIMESTAMP <<DEFAULT now()>>
}

entity "preferencias_notificacion" as prefsNotif {
  * **id** : TEXT <<PK, cuid>>
  --
  * usuario_id : TEXT <<UNIQUE, FK>>
  * email_habilitado : BOOLEAN <<DEFAULT true>>
  * recordatorios_rutina : BOOLEAN <<DEFAULT true>>
  * recordatorios_cita : BOOLEAN <<DEFAULT true>>
  silencio_inicio : TEXT <<HH:MM>>
  silencio_fin : TEXT <<HH:MM>>
}

entity "auditoria" as auditoria {
  * **id** : TEXT <<PK, cuid>>
  --
  usuario_id : TEXT
  * accion : TEXT <<LOGIN|VIEW_CLINICAL_HISTORY|...>>
  * entidad : TEXT
  entidad_id : TEXT
  metadata : TEXT <<JSON>>
  ip : TEXT
  * created_at : TIMESTAMP <<DEFAULT now()>>
}

entity "tokens_refresco" as refresh {
  * **id** : TEXT <<PK, cuid>>
  --
  * token : TEXT <<UNIQUE>>
  * usuario_id : TEXT <<FK>>
  * expira_at : TIMESTAMP <<NOT NULL>>
  * created_at : TIMESTAMP <<DEFAULT now()>>
}

usuarios ||--o| pacientes : "es un"
usuarios ||--o| terapeutas : "es un"
usuarios ||--o| prefsNotif : "configura"
usuarios ||--o{ notificaciones : "recibe"
usuarios ||--o{ refresh : "posee"
usuarios ||--o{ disponibilidad : "ofrece"

pacientes }|--|| terapeutas : "asignado a"
pacientes ||--|| historial : "tiene"
historial ||--o{ diagnosticos : "contiene"
historial ||--o{ notas : "registra"
pacientes ||--o{ documentos : "adjunta"

pacientes ||--o{ planes : "recibe"
terapeutas ||--o{ planes : "define"
planes ||--|{ fases : "compuesto por"

plantillas ||--o{ actividades : "instancia"
rutinas }o--o| pacientes : "asignada a"
rutinas ||--|{ actividades : "contiene"

terapeutas ||--o{ asignaciones : "asigna"
pacientes ||--o{ asignaciones : "recibe"
rutinas ||--o{ asignaciones : "origen"
fases ||--o{ asignaciones : "prescribe"

asignaciones ||--o{ sesiones : "genera"
rutinas ||--o{ sesiones : "ejecuta"
sesiones ||--|{ sesionEj : "detalla"

pacientes ||--o{ feedback : "registra"
rutinas ||--o{ feedback : "evaluada en"
feedback ||--o{ puntosDolor : "localiza"
pacientes ||--o{ escalas : "medido en"
terapeutas ||--o{ escalas : "evalua"

pacientes ||--o{ citas : "asiste a"
terapeutas ||--o{ citas : "atiende"
salas ||--o{ citas : "reservada para"
planes ||--o{ citas : "contexto de"
pacientes ||--o{ listaEspera : "espera"
terapeutas ||--o{ listaEspera : "cola de"

pacientes ||--o{ conversaciones : "participa"
terapeutas ||--o{ conversaciones : "participa"
conversaciones ||--|{ mensajes : "contiene"

@enduml
