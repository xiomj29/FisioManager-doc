}


ana --> ter : atendida por
ana --> hc : posee
hc --> diag
hc --> nota1
ana --> doc : adjunta
diag --> ter
nota1 --> ter

ana --> plan : tiene
plan --> ter : elaborado por
plan --> fase : contiene
plan --> asig : prescribe

cita --> ana
cita --> ter
cita --> sala
cita --> plan
ter --> horario
ana --> notif : recibe

ter --> rut : crea
plant --> act : instancia
rut *-- act
asig --> rut
asig --> ana
asig --> ter
asig --> ses
ses --> fb
fb --> dolor : localiza
ana --> escala : medido en
escala --> ter : evaluada por

@enduml
