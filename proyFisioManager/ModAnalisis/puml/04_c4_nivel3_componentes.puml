@startuml FisioManager_C4_Componentes


skinparam backgroundColor #FAFAFA
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam shadowing false
skinparam roundCorner 10

skinparam rectangle {
    BackgroundColor<<componente>> #85BBF0
    BorderColor<<componente>> #5D82A8
    FontColor<<componente>> #000000
    BackgroundColor<<container>> #438DD5
    BorderColor<<container>> #2E6295
    FontColor<<container>> white
    FontStyle bold
}

skinparam database {
    BackgroundColor #438DD5
    BorderColor #2E6295
    FontColor white
}

title <b>FisioManager - C4 Nivel 3: Componentes de la API (flujo de Feedback)</b>

rectangle "SPA Web\n<size:9>[React + TS]</size>" as spa <<container>>
database "PostgreSQL\n<size:9>[Prisma]</size>" as bd
rectangle "MinIO / disco\n<size:9>Object Storage</size>" as minio <<container>>
rectangle "Whisper\n<size:9>[Python]</size>" as whisper <<container>>
rectangle "Ollama\n<size:9>[LLM]</size>" as ollama <<container>>

rectangle "**API Express (modular)**" as boundary {

    rectangle "Middlewares\n<size:9>auth (JWT), role,</size>\n<size:9>validate (Zod), rate-limit</size>" as mw <<componente>>

    rectangle "feedback.routes\n<size:9>[Express Router]</size>\n<size:9>POST /feedback</size>\n<size:9>POST /feedback/audio</size>" as routes <<componente>>

    rectangle "feedback.controller\n<size:9>catchAsync, ok/created</size>" as ctrl <<componente>>

    rectangle "feedback.service\n<size:9>Reglas de negocio;</size>\n<size:9>dispara alerta de dolor</size>" as svc <<componente>>

    rectangle "ai.service\n<size:9>transcribeAudio (Whisper)</size>\n<size:9>generateClinicalSummary (Ollama)</size>" as ai <<componente>>

    rectangle "storage (lib)\n<size:9>local | S3/MinIO</size>" as storage <<componente>>

    rectangle "notification.service\n<size:9>Centro in-app + email +</size>\n<size:9>push por Socket.IO</size>" as notif <<componente>>

    rectangle "feedback.repository\n<size:9>[Prisma Client]</size>" as repo <<componente>>

    rectangle "painPoint.repository\n<size:9>[Prisma Client]</size>" as repoPain <<componente>>
}

spa --> mw : POST audio + datos\n<size:9>[multipart / JSON]</size>
mw --> routes
routes --> ctrl
ctrl --> svc
ctrl --> ai : Audio -> transcripcion + resumen
ai --> whisper
ai --> ollama
ctrl --> storage : Guarda audio
storage --> minio
svc --> repo : Persiste feedback
svc --> repoPain : Guarda puntos de dolor
svc --> notif : Alerta de dolor alto
repo --> bd
repoPain --> bd

@enduml
