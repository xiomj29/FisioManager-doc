@startuml FisioManager_Secuencia_RegistroFeedback

skinparam backgroundColor #FEFEFE
skinparam sequence {
  ArrowColor #2E75B6
  ActorBorderColor #1F4E79
  LifeLineBorderColor #2E75B6
  ParticipantBorderColor #2E75B6
  ParticipantBackgroundColor #D6EAF8
  ParticipantFontColor #1F4E79
  ActorBackgroundColor #AED6F1
}
skinparam defaultFontName Arial
skinparam shadowing false

title Diagrama de Secuencia - Flujo 1: Registro de Feedback

actor "Paciente" as Paciente #AED6F1
participant "UIRegistroFeedback" as UI #D6EAF8
participant "feedback.controller" as Ctrl #D6EAF8
participant "ai.service\n(Whisper + Ollama)" as AI #E8DAEF
participant "storage" as Audio #D6EAF8
participant "feedback.service" as Svc #D6EAF8
participant "notification.service" as Notif #D6EAF8
database "PostgreSQL" as DB #E8DAEF

== Captura de Datos ==

Paciente -> UI : Selecciona estado emocional,\nnivel de dolor y marca el\nmapa corporal de dolor
activate UI

opt Grabacion de audio (opcional)
    Paciente -> UI : Graba una nota de voz
    UI -> Ctrl : POST /feedback/audio\n(audio multipart)
    activate Ctrl
    Ctrl -> Ctrl : Verifica consentimiento\nde audio del paciente
    Ctrl -> Audio : guarda el audio
    Audio --> Ctrl : audioUrl
    Ctrl -> AI : transcribeAudio(audio)
    AI --> Ctrl : transcripcion (Whisper)
    Ctrl -> AI : generateClinicalSummary(transcripcion)
    AI --> Ctrl : resumen clinico (Ollama)
    Ctrl --> UI : { audioUrl, transcripcion, resumenIA }
    deactivate Ctrl
end

== Envio del Feedback ==

Paciente -> UI : Confirmar y enviar
UI -> Ctrl : POST /feedback\n(painLevel, emotionalState,\npainPoints, audioUrl?,\ntranscripcion?, resumenIA?)
activate Ctrl
Ctrl -> Svc : create(data, patientId)
activate Svc

Svc -> Svc : Valida painLevel in [1..10]\ny estado emocional

Svc -> DB : INSERT Feedback\n(painLevel, emotionalState,\naudioUrl, transcripcion,\nresumenIA, date)
activate DB
DB --> Svc : feedbackId
deactivate DB

opt Hay puntos de dolor
    Svc -> DB : INSERT PuntoDolor[]\n(feedbackId, parteCuerpo,\nlado, intensidad)
    activate DB
    DB --> Svc : OK
    deactivate DB
end

opt painLevel >= 7 (dolor alto)
    Svc -> Notif : alertHighPain(patientId,\npainLevel, emotionalState)
    Notif -> DB : INSERT Notificacion\n(terapeuta, HIGH_PAIN)
    activate DB
    DB --> Notif : OK
    deactivate DB
    Notif -->> Svc : aviso enviado (in-app + email)
end

Svc --> Ctrl : Feedback creado
deactivate Svc
Ctrl --> UI : 201 Created
deactivate Ctrl
UI --> Paciente : "Feedback enviado correctamente"
deactivate UI

note over AI
  La transcripcion (Whisper) y el
  resumen (Ollama) se ejecutan al
  subir el audio y se guardan dentro
  del propio Feedback. No hay una
  entidad separada de analisis.
end note

note over Svc, DB
  El feedback queda disponible de
  inmediato para el terapeuta, con
  graficas de tendencia y mapa de dolor.
end note

@enduml
