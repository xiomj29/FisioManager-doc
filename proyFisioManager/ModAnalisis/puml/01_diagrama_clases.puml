@startuml FisioManager_DiagramaClases


skinparam backgroundColor #FAFAFA
skinparam classBackgroundColor #E8F4F8
skinparam classBorderColor #2E75B6
skinparam classArrowColor #2E75B6
skinparam classFontName Arial
skinparam classFontSize 12
skinparam packageBackgroundColor #F0F8E8
skinparam packageBorderColor #5B9D3E
skinparam classAttributeIconSize 0

hide methods
hide circle

title <b>FisioManager - Diagrama de Clases Conceptuales</b>\n<size:11>Modelo de dominio: conceptos, atributos y asociaciones</size>

package "Usuarios" {

    abstract class Usuario {
        nombre
        email
        telefono
        avatarUrl
        rol
        activo
        consentimientoAudio
    }

    class Paciente {
        edad
        condicion
    }

    class Terapeuta {
        cedula
        especialidad
    }

    class Administrador {
    }
}

package "Clinico" {

    class HistorialClinico {
        tipoSangre
        alergias
        antecedentes
    }

    class Diagnostico {
        codigoCIE10
        descripcion
        estado
    }

    class NotaClinica {
        contenido
        visibleParaPaciente
        fecha
    }

    class DocumentoClinico {
        nombreArchivo
        urlArchivo
        mimeType
        categoria
        visibleParaPaciente
    }

    class PlanTratamiento {
        nombre
        objetivoClinico
        fechaInicio
        fechaFinEstimada
        estado
    }

    class FaseTratamiento {
        nombre
        orden
        duracionSemanas
        objetivos
    }
}

package "Agenda" {

    class Cita {
        fechaHora
        estado
        notas
        grupoRecurrencia
    }

    class Sala {
        nombre
        ubicacion
        capacidad
        equipamiento
    }

    class HorarioDisponible {
        diaSemana
        horaInicio
        horaFin
    }

    class ListaEspera {
        desde
        hasta
        estado
    }
}

package "Rutinas" {

    class Rutina {
        titulo
        tipo
        completada
        fechaAsignacion
    }

    class PlantillaActividad {
        titulo
        descripcion
        tipo
        parteCuerpo
        videoUrl
        imagenUrl
    }

    class Actividad {
        titulo
        descripcion
        duracionMinutos
        repeticiones
        descansoSegundos
        orden
    }

    class AsignacionRutina {
        fechaInicio
        fechaFin
        frecuencia
        estado
    }
}

package "Seguimiento" {

    class SesionEjecucion {
        estado
        tasaCumplimiento
        iniciadaEn
        finalizadaEn
    }

    class Feedback {
        nivelDolor
        estadoEmocional
        audioUrl
        transcripcion
        resumenIA
        fecha
    }

    class PuntoDolor {
        parteCuerpo
        lado
        intensidad
        nota
    }

    class EscalaResultado {
        tipo
        etiqueta
        valor
        unidad
        medidoEn
    }
}

package "Comunicacion" {

    class Conversacion {
        ultimoMensajeEn
    }

    class Mensaje {
        contenido
        leidoEn
        fecha
    }

    class Notificacion {
        tipo
        titulo
        cuerpo
        linkUrl
        leida
    }

    class PreferenciaNotificacion {
        emailHabilitado
        recordatoriosRutina
        recordatoriosCita
        silencioInicio
        silencioFin
    }
}

package "Plataforma" {

    class RegistroAuditoria {
        accion
        entidad
        entidadId
        ip
        fecha
    }
}


Usuario <|-- Paciente
Usuario <|-- Terapeuta
Usuario <|-- Administrador

Usuario "1" -- "0..1" PreferenciaNotificacion : configura
Usuario "1" -- "*" Notificacion : recibe

Paciente "*" -- "1" Terapeuta : atendido por
Paciente "1" -- "1" HistorialClinico : posee
HistorialClinico "1" -- "*" Diagnostico : contiene
HistorialClinico "1" -- "*" NotaClinica : registra
Paciente "1" -- "*" DocumentoClinico : adjunta
Diagnostico "*" -- "1" Terapeuta : registrado por
NotaClinica "*" -- "1" Terapeuta : redactada por

Paciente "1" -- "*" PlanTratamiento : tiene
PlanTratamiento "*" -- "1" Terapeuta : elaborado por
PlanTratamiento "1" -- "*" FaseTratamiento : compuesto por
PlanTratamiento "1" -- "*" AsignacionRutina : prescribe

Terapeuta "1" -- "*" Rutina : crea
PlantillaActividad "1" -- "*" Actividad : instancia
Rutina "1" *-- "*" Actividad : compone

AsignacionRutina "*" -- "1" Rutina : asigna
AsignacionRutina "*" -- "1" Paciente : a paciente
AsignacionRutina "*" -- "1" Terapeuta : asignada por

AsignacionRutina "1" -- "*" SesionEjecucion : genera
SesionEjecucion "*" -- "1" Paciente : ejecuta
Paciente "1" -- "*" Feedback : registra
Feedback "1" -- "*" PuntoDolor : localiza
Paciente "1" -- "*" EscalaResultado : medido en
EscalaResultado "*" -- "1" Terapeuta : evaluada por

Cita "*" -- "1" Paciente : agendada para
Cita "*" -- "1" Terapeuta : atendida por
Cita "*" -- "0..1" Sala : ocupa
Cita "*" -- "0..1" PlanTratamiento : asociada a
Terapeuta "1" -- "*" HorarioDisponible : ofrece
Paciente "1" -- "*" ListaEspera : se inscribe en
ListaEspera "*" -- "1" Terapeuta : cola de

Conversacion "*" -- "1" Paciente : participa
Conversacion "*" -- "1" Terapeuta : participa
Conversacion "1" *-- "*" Mensaje : contiene

@enduml
