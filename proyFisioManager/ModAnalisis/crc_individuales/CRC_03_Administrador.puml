@startuml CRC_Administrador


skinparam backgroundColor #FAFAFA
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam shadowing false
skinparam roundCorner 8

skinparam class {
    BackgroundColor #FFF8DC
    BorderColor #B8860B
    HeaderBackgroundColor #FFD700
    AttributeFontColor #000000
}

title <b>CRC Card: Administrador</b>

class "Responsabilidades" as Resp {
    + Identificarse con privilegios elevados
    + Crear, editar y desactivar cuentas de usuario
    + Asignar y modificar roles de usuario
    + Monitorear el funcionamiento del sistema
    + Auditar accesos a datos clinicos sensibles
    + Configurar parametros globales del sistema
}

class "Colaboradores" as Col {
    Usuario (clase base)
    Paciente
    Terapeuta
    LogAcceso
    MetricasSistema
}

Resp -[hidden]right- Col

@enduml
